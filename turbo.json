{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^build", "^generate"]
    },
    "test": {
      "dependsOn": ["^generate"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "migrate:deploy": {
      "cache": false
    }
  }
}
